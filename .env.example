# Bot token from https://discord.com/developers/applications -> Bot -> Token.
# Invite the bot with:
# https://discord.com/oauth2/authorize?client_id={client_id}&scope=bot%20applications.commands&permissions=3148800
# This grants the bot the permissions to connect, speak, send messages, and use application commands.
DISCORD_TOKEN=

# How much audio to hold in memory for a track.
# Larger values reduce chance of stutter on networks with a lot of jitter.
# Increasing this increases memory and the time to start playback.
#
# If you see "audio buffer ran dry", enable debug logging and check the
# "buffer depth" messages first:
#
# - Buffer depth often near zero:
#   The audio source is arriving too slowly. Increasing BUFFER_MS probably
#   won't help; it will mostly delay when the stuttering starts.
#
# - Buffer depth normally healthy but occasionally drops under load:
#   Increasing BUFFER_MS may help.
#BUFFER_MS=2000

# Fraction of BUFFER_MS that must be buffered before playback starts.
# If using a very small buffer, you can set this to 1.
#PREFILL_RATIO=0.5

# Used to size the buffer only when yt-dlp reports no bitrate for the track.
# YouTube's itag 251 is roughly 160 kbps.
#ASSUMED_BITRATE_BPS=160000

# yt-dlp binary path. If unset, the bot will look for `yt-dlp` in PATH.
#YTDLP_PATH=yt-dlp

# Exported Netscape-format cookie file location. Passed to yt-dlp --cookies.
# See https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
#YTDLP_COOKIES_FILE=secrets/cookies.txt

# Kill yt-dlp if it has not answered by then.
#YTDLP_TIMEOUT_MS=15000

# Extra argv entries, split on whitespace. E.g.:
#   YTDLP_EXTRA_ARGS=--cookies-from-browser firefox --limit-rate 2M
# Arguments containing spaces cannot be expressed here.
# See https://github.com/yt-dlp/yt-dlp#usage-and-options
#YTDLP_EXTRA_ARGS=

# Tokio worker threads. Unset to use default (number of cores).
# The bot is mostly I/O-bound.
#WORKER_THREADS=

# Optional Spotify playlist metadata access. The client ID and secret are
# enough to read public playlists.
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=

# Optional. Lifts 100-track ceiling and allows private playlists. 
# Can be optained via scripts/spotify_refresh_token
#SPOTIFY_REFRESH_TOKEN=

# Path of cache db. Set to empty to disable caching.
#CACHE_PATH=cache.redb

# Log filter, e.g. `debug` or `slap_core=debug,info`. Defaults to `info`.
#RUST_LOG=info
