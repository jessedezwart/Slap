# Copy to `.env` and fill in the token. Everything else already has a working
# default and can stay commented out.
#
# The bot reads its process environment, not this file. Load it with one of:
#
#   bash / zsh   set -a; . ./.env; set +a; cargo run --release
#   PowerShell   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim()) } }; cargo run --release
#   docker       docker run --env-file .env ...
#
# Never commit the filled-in `.env` — it holds a bot token.

# --- required ---------------------------------------------------------------

# Bot token from https://discord.com/developers/applications -> Bot -> Token.
# Invite the bot with the `bot` and `applications.commands` scopes; no
# privileged intents are needed.
DISCORD_TOKEN=

# --- buffering (this is the anti-stutter knob) ------------------------------

# How much audio to hold ahead of songbird's mixer, in milliseconds of
# playback. Converted to a byte budget using the track's real bitrate when
# yt-dlp reports one. Raise this first if you see "audio buffer ran dry" in the
# logs. The budget is clamped to 64 KiB..8 MiB per track whatever you set here.
#BUFFER_MS=5000

# Fraction of BUFFER_MS that must be buffered before playback starts. Higher
# means a longer pause before the first sound and a deeper cushion against a
# slow network; 0.0 starts as soon as the first bytes land.
#PREFILL_RATIO=0.5

# Give up waiting for that prefill and start anyway. Hitting this is a warning,
# not an error — playback still begins.
#PREFILL_TIMEOUT_MS=10000

# Used to size the buffer only when yt-dlp reports no bitrate for the track.
# YouTube's itag 251 is roughly 160 kbps.
#ASSUMED_BITRATE_BPS=160000

# --- yt-dlp -----------------------------------------------------------------

# Binary to spawn. Always invoked as argv — there is no shell in this path, so
# this is a program name or path, not a command line.
#YTDLP_PATH=yt-dlp

# Kill yt-dlp if it has not answered by then.
#YTDLP_TIMEOUT_MS=15000

# Extra argv entries, split on whitespace. Use this for age-restricted videos
# or rate limiting, e.g.:
#   YTDLP_EXTRA_ARGS=--cookies-from-browser firefox
# Arguments containing spaces cannot be expressed here.
#YTDLP_EXTRA_ARGS=

# --- runtime ----------------------------------------------------------------

# Tokio worker threads. One is deliberate: the realtime work runs on songbird's
# own mixer thread, and everything here is IO-bound. Raise it only if you are
# running many guilds on more than one core.
#WORKER_THREADS=1

# Log filter. Use rust_music_bot=debug to see buffer depth and stream
# lifecycle, including the "audio buffer ran dry" line.
#RUST_LOG=rust_music_bot=info,warn
